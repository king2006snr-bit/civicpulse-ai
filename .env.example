APP_NAME=CivicPulse AI
ENVIRONMENT=development
SQLITE_DATABASE_PATH=backend/civicpulse.db
CORS_ORIGINS=["http://localhost:5500"]
AUTH_ADMIN_EMAIL=
AUTH_ADMIN_USERNAME=
AUTH_ADMIN_PASSWORD=
AUTH_TOKEN_SECRET=
AUTH_TOKEN_TTL_MINUTES=60
IMAGE_STORAGE_PROVIDER=local
IMAGE_STORAGE_PATH=backend/local_images
IMAGE_MAX_SIZE_BYTES=5242880
IMAGE_MAX_COUNT_PER_UPLOAD=3
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TIMEOUT_SECONDS=30
MAP_PROVIDER=osm
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
MAP_SATELLITE_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
MAP_SATELLITE_ATTRIBUTION=Tiles &copy; Esri
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=CivicPulseAI/1.0 (replace with your deployment contact)
GEOCODING_TIMEOUT_SECONDS=8
# --- ML risk prediction service (optional overrides) ---
# PYTHON_EXECUTABLE='C:\Users\you\AppData\Local\Programs\Python\Python314\python.exe'  # interpreter with ml/requirements.txt installed
# (legacy alias ML_PYTHON is also honoured). If unset, the server auto-detects: py -3, python, python3 - and rejects Microsoft Store stubs.
# ML_PORT=8765                            # local port for the auto-started ml/service.py
# ML_SERVICE_URL=http://127.0.0.1:8765    # use an externally managed service instead of auto-starting one
